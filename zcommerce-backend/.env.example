NODE_ENV=development
PORT=4000
APP_NAME=zCommerce
APP_URL=http://localhost:4000
LOG_LEVEL=info

DATABASE_URL=postgres://postgres:@127.0.0.1:5432/zcommerce
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=10

REDIS_URL=redis://127.0.0.1:6379

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
ENCRYPTION_KEY=change-me-64-hex-chars

CORS_ORIGINS=http://localhost:5173,http://localhost:3001,http://localhost:3110,http://localhost:3111,http://localhost:3112,http://localhost:3113,http://localhost:3114
# Optional platform domain: <slug>.<STORE_BASE_DOMAIN> resolves to that tenant (e.g. demo.localhost:3001)
STORE_BASE_DOMAIN=localhost
PLATFORM_NAME=zCommerce
PLATFORM_TAGLINE=Launch and grow your online store
ADMIN_URL=http://localhost:5173
SUPPORT_EMAIL=
STOREFRONT_URL=http://localhost:3001
# Shared secret for the storefront's POST /api/revalidate webhook (must match zcommerce-store REVALIDATE_SECRET)
REVALIDATE_SECRET=change-me

UPLOAD_MAX_MB=5

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="zCommerce <no-reply@zcommerce.test>"
